+ * @file        rex/ui/display_clock.h
+ * @brief       [ng2 ps5 port] When the display last refreshed, and how often
+ *              it does: measured by the presenter, read by the guest vblank
+ *              timer so the game's frames are paced by the panel rather than
+ *              by a free-running clock (graphics_system.cpp).
+ *
+ * On the PS5 the presenter paints every refresh and its swapchain acquire
+ * returns when the previous flip happened, so the moment an acquire that had
+ * to wait returns is a display vblank. Elsewhere nothing writes these and the
+ * timer runs as before.
+ */
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+namespace rex::ui::display_clock {
+
+inline std::atomic<int64_t> last_vblank_ns{0};  // steady_clock, 0: unknown
+inline std::atomic<int64_t> period_ns{0};       // averaged, 0: unknown
+
+inline int64_t NowNs() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+// From the presenter, after an acquire that waited `waited_ns` for a flip.
+inline void NoteAcquire(int64_t waited_ns) {
+  if (waited_ns < 3'000'000) {
+    return;  // (an image was free: no flip was waited for)
+  }
+  const int64_t now = NowNs();
+  const int64_t previous = last_vblank_ns.exchange(now, std::memory_order_acq_rel);
+  const int64_t interval = previous ? now - previous : 0;
+  // Only one-refresh intervals between 50 and 80 Hz count towards the period.
+  if (interval >= 12'500'000 && interval <= 20'000'000) {
+    const int64_t period = period_ns.load(std::memory_order_relaxed);
+    period_ns.store(period ? period + (interval - period) / 16 : interval, std::memory_order_relaxed);
+  }
+}
+
+}  // namespace rex::ui::display_clock
