+// [ng2 ps5 port] A screen flash: a full-screen overlay of a few vertices,
+// blended over what is there, drawn by a pixel shader that samples nothing and
+// whose first constant is near white. The game draws its flash (the Flying
+// Swallow's) this way; a fade to black or a dimmed menu backdrop is not near
+// white and a textured overlay samples something, so they are left alone.
+// Each distinct candidate is logged once, flash or not, so a flash drawn some
+// other way can be identified from a log.
+bool VulkanCommandProcessor::IsScreenFlashDraw(const VulkanShader& pixel_shader,
+                                               const PrimitiveProcessor::ProcessingResult& primitives) {
+  const RegisterFile& regs = *register_file_;
+  if (primitives.host_draw_vertex_count > 6 || pixel_shader.GetUsedTextureMaskAfterTranslation()) {
+    return false;
+  }
+  const auto blend = regs.Get<reg::RB_BLENDCONTROL>(reg::RB_BLENDCONTROL::rt_register_indices[0]);
+  if (blend.color_srcblend == xenos::BlendFactor::kOne && blend.color_destblend == xenos::BlendFactor::kZero) {
+    return false;  // replaces the picture: not an overlay
+  }
+  const auto tl = regs.Get<reg::PA_SC_WINDOW_SCISSOR_TL>();
+  const auto br = regs.Get<reg::PA_SC_WINDOW_SCISSOR_BR>();
+  if (br.br_x < tl.tl_x + 1200 || br.br_y < tl.tl_y + 680) {
+    return false;  // not the whole 1280x720 screen
+  }
+  const auto& map = pixel_shader.constant_register_map().float_bitmap;
+  uint32_t first = UINT32_MAX;
+  for (uint32_t i = 0; i < 4 && first == UINT32_MAX; ++i) {
+    uint32_t bit;
+    if (rex::bit_scan_forward(map[i], &bit)) {
+      first = i * 64 + bit;
+    }
+  }
+  if (first == UINT32_MAX) {
+    return false;
+  }
+  float c[4];
+  std::memcpy(c, &regs[XE_GPU_REG_SHADER_CONSTANT_256_X + first * 4], sizeof(c));
+  const bool white = c[0] >= 0.6f && c[1] >= 0.6f && c[2] >= 0.6f && c[3] > 0.02f;
+  static std::mutex logged_mutex;
+  static std::set<uint64_t> logged;
+  {
+    std::lock_guard lock(logged_mutex);
+    if (logged.insert(pixel_shader.ucode_data_hash() ^ (uint64_t(white) << 63)).second && logged.size() < 64) {
+      REXGPU_INFO("Screen overlay candidate: PS {:016X}, blend {:08X}, c{} = ({:.2f}, {:.2f}, {:.2f}, {:.2f}){}",
+                  pixel_shader.ucode_data_hash(), blend.value, first, c[0], c[1], c[2], c[3],
+                  white ? " - a flash" : "");
+    }
+  }
+  if (!white || !REXCVAR_GET(ng2_remove_screen_flash)) {
+    return false;
+  }
+  static std::atomic<int> removed{0};
+  if (removed.fetch_add(1, std::memory_order_relaxed) < 5) {
+    REXGPU_INFO("Screen flash removed (PS {:016X})", pixel_shader.ucode_data_hash());
+  }
+  return true;
+}
