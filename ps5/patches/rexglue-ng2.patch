+// [ps5 port] Copies the float constants a shader uses, one memcpy per run of
+// consecutive constants instead of one per constant; the same bytes in the
+// same order (WWE 2K14 Recomp's 0041, BSD-3, PromethenDev).
+void CopyFloatConstantMapEntry(uint8_t*& mapping, const uint32_t* regs, uint64_t float_constant_map_entry) {
+  uint32_t float_constant_index;
+  while (rex::bit_scan_forward(float_constant_map_entry, &float_constant_index)) {
+    const uint64_t run_start_bits = float_constant_map_entry >> float_constant_index;
+    uint32_t run_length;
+    if (!rex::bit_scan_forward(~run_start_bits, &run_length)) {
+      run_length = 64 - float_constant_index;
+    }
+    const size_t run_bytes = size_t(run_length) * sizeof(float) * 4;
+    std::memcpy(mapping, &regs[float_constant_index * 4], run_bytes);
+    mapping += run_bytes;
+    const uint64_t run_mask = run_length == 64 ? ~uint64_t(0) : (UINT64_C(1) << run_length) - 1;
+    float_constant_map_entry &= ~(run_mask << float_constant_index);
+  }
+}
