+    std::recursive_mutex& m = mutex();
+    for (int attempt = 0; attempt < 32; ++attempt) {
+      if (m.try_lock()) {
+        return;
+      }
+      for (int i = 0; i < 32; ++i) {
+#if defined(__x86_64__) || defined(_M_X64)
