@@ -0,0 +1,40 @@
+/**
+ * @file        rex/graphics/texture_load_hook.h
+ * @brief       [ng2] A title's look at each guest texture just before the GPU
+ *              copy of its memory is brought up to date: for dumping it (the
+ *              texture pack tools) and for writing a replacement over it in
+ *              guest memory (the PS5 port's PlayStation button prompts).
+ *
+ * Called on the GPU thread from TextureCache::PrepareTextureLoad, for the base
+ * level of a non-resolve texture whose guest memory changed or was never
+ * loaded, BEFORE the shared memory upload: bytes the hook writes into guest
+ * memory are the bytes the texture is made from. Keep it cheap - it runs once
+ * per (re)load, and anything slow belongs on a thread of the title's own.
+ */
+#pragma once
+
+#include <cstdint>
+
+namespace rex::graphics {
+
+struct GuestTextureLoad {
+  uint32_t base_address;  // physical guest address of the base level
+  uint32_t base_size;     // its guest extent in bytes (tiling padding included)
+  uint32_t width, height;
+  uint32_t pitch;          // TextureKey::pitch (32-texel units)
+  uint32_t format;         // xenos::TextureFormat
+  uint32_t endianness;     // xenos::Endian
+  uint32_t tiled;
+  uint32_t dimension;      // xenos::DataDimension
+  uint32_t depth_or_array_size;
+  uint32_t mip_max_level;
+  uint32_t packed_mips;
+};
+
+using GuestTextureLoadHook = void (*)(const GuestTextureLoad& texture);
+
+// One hook per process; nullptr removes it.
+void SetGuestTextureLoadHook(GuestTextureLoadHook hook);
+GuestTextureLoadHook GetGuestTextureLoadHook();
+
+}  // namespace rex::graphics
