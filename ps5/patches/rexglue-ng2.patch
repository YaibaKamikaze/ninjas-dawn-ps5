diff --git a/include/rex/graphics/ng2_phase_timer.h b/include/rex/graphics/ng2_phase_timer.h
new file mode 100644
index 00000000..b30617a1
--- /dev/null
+++ b/include/rex/graphics/ng2_phase_timer.h
@@ -0,0 +1,80 @@
+// [ng2 ps5 port] Where the GPU command thread's time goes.
+//
+// The command thread turns the game's GPU command stream into Vulkan work. When
+// it is busy close to 1000 ms/s it is what limits the frame rate, and this says
+// which part of its work is responsible: every 10 s as a line beside the busy
+// figure, and for any single frame that took longer than 50 ms, so a hitch can
+// be put down to a cause (a pipeline, a texture upload, a resolve, a wait for
+// the presenter or the host GPU - or, when the thread was idle, the game itself).
+//
+// Phases nest: texture loads, pipeline creation and fence waits happen inside
+// draws and submissions, so the figures are not meant to add up.
+//
+// Reading the clock is not free on the PS5 (clock_gettime), and draws come by
+// the thousand each frame: the per-draw phases (Scope with detail = true) run
+// only while the gpu_phase_timer_details cvar is on (SETTINGS > Developer).
+// The rest happen a few times a frame and always run.
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+namespace rex::graphics::ng2phase {
+
+enum Phase : int {
+  kBusy,         // executing the command stream (the busy figure)
+  kDraw,         // IssueDraw, resolves included
+  kCopy,         // resolves (EDRAM -> memory copies)
+  kSwap,         // the end of a frame, handing it to the presenter
+  kSubmit,       // EndSubmission: recording and vkQueueSubmit
+  kTextureLoad,  // texture uploads and untiling
+  kPipeline,     // vkCreateGraphicsPipelines on the command thread
+  kFenceWait,    // waiting for the host GPU
+  kRegWait,      // the game's WAIT_REG_MEM
+  // Inside a draw:
+  kPrimitives,     // primitive processing (index conversion, vertex ranges)
+  kTextures,       // RequestTextures (texture loads counted again above)
+  kRenderTargets,  // the render target cache's Update
+  kBindings,       // UpdateBindings: constants and descriptor sets
+  kLockWait,       // waiting for the global lock in shared memory requests
+  kCount,
+};
+
+inline std::atomic<int64_t> g_window_ns[kCount];
+inline std::atomic<uint32_t> g_window_pipelines_async{0};
+inline std::atomic<uint32_t> g_window_draws{0};
+inline thread_local bool tls_command_thread = false;
+// gpu_phase_timer_details, refreshed by the command thread once per batch.
+inline bool g_details = false;
+inline thread_local int64_t tls_frame_ns[kCount];
+
+inline int64_t NowNs() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+inline void Add(Phase phase, int64_t ns) {
+  g_window_ns[phase].fetch_add(ns, std::memory_order_relaxed);
+  if (tls_command_thread)
+    tls_frame_ns[phase] += ns;
+}
+
+struct Scope {
+  explicit Scope(Phase p, bool detail = false) : phase(p), start(detail && !g_details ? -1 : NowNs()) {}
+  ~Scope() {
+    if (start >= 0)
+      Add(phase, NowNs() - start);
+  }
+  Scope(const Scope&) = delete;
+  Scope& operator=(const Scope&) = delete;
+  Phase phase;
+  int64_t start;
+};
+
+// Called by the command thread after each swap: logs the frame's breakdown
+// when it took longer than 50 ms (command_processor.cpp).
+void EndFrame();
+
+}  // namespace rex::graphics::ng2phase
