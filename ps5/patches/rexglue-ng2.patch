+// [ng2 ps5 port] One resolve of a frame report (see frame_report_now): the
+// destination bytes from the GPU's copy of guest memory, waited for, written
+// with the registers that say how to read them.
+void VulkanCommandProcessor::FrameReportResolve(uint32_t written_address, uint32_t written_length) {
+  const auto& regs = *register_file_;
+  const auto copy_control = regs.Get<reg::RB_COPY_CONTROL>();
+  const auto dest_info = regs.Get<reg::RB_COPY_DEST_INFO>();
+  const auto dest_pitch = regs.Get<reg::RB_COPY_DEST_PITCH>();
+  const uint32_t dest_base = regs[XE_GPU_REG_RB_COPY_DEST_BASE];
+  const auto surface = regs.Get<reg::RB_SURFACE_INFO>();
+  const uint32_t src = copy_control.copy_src_select;
+  uint32_t src_format = 0;
+  if (src >= 4) {
+    src_format = uint32_t(regs.Get<reg::RB_DEPTH_INFO>().depth_format) | 0x100;  // depth
+  } else {
+    static const uint32_t kColorInfo[] = {XE_GPU_REG_RB_COLOR_INFO, XE_GPU_REG_RB_COLOR1_INFO,
+                                          XE_GPU_REG_RB_COLOR2_INFO, XE_GPU_REG_RB_COLOR3_INFO};
+    src_format = uint32_t(reg::RB_COLOR_INFO{regs[kColorInfo[src]]}.color_format);
+  }
+  const uint32_t seq = g_report.resolves++;
+  const uint32_t src_base = src >= 4 ? uint32_t(regs.Get<reg::RB_DEPTH_INFO>().depth_base)
+                                     : (src == 0 ? uint32_t(regs.Get<reg::RB_COLOR_INFO>().color_base) : 0);
+  // The EDRAM itself for the first resolves (fragment shader interlock keeps
+  // it in a buffer): shows whether the draws wrote anything before the copy.
+  const bool dump_edram = seq < 16 && render_target_cache_->GetPath() ==
+                                          RenderTargetCache::Path::kPixelShaderInterlock;
+  std::string line = fmt::format(
+      "{} frame {} written {:08X}+{:X} dest_base {:08X} dest_format {} dest_endian {} "
+      "dest_number {} dest_swap {} dest_exp_bias {} pitch {} height {} src {} src_format {:X} "
+      "surface_pitch {} msaa {} color_clear {} depth_clear {} src_base {}",
+      seq, g_report.frame, written_address, written_length, dest_base,
+      uint32_t(dest_info.copy_dest_format), uint32_t(dest_info.copy_dest_endian),
+      uint32_t(dest_info.copy_dest_number), uint32_t(dest_info.copy_dest_swap),
+      int32_t(dest_info.copy_dest_exp_bias), uint32_t(dest_pitch.copy_dest_pitch),
+      uint32_t(dest_pitch.copy_dest_height), src, src_format, uint32_t(surface.surface_pitch),
+      uint32_t(surface.msaa_samples), uint32_t(copy_control.color_clear_enable),
+      uint32_t(copy_control.depth_clear_enable), src_base);
+  if (texture_cache_->IsDrawResolutionScaled()) {
+    line += " (scaled: not captured - use 720p)";
+  } else if (written_length <= (64u << 20)) {
+    const ui::vulkan::VulkanDevice* const vulkan_device = GetVulkanDevice();
+    const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+    const VkDevice device = vulkan_device->device();
+    VkBuffer buffer = VK_NULL_HANDLE;
+    VkDeviceMemory memory = VK_NULL_HANDLE;
+    void* mapping = nullptr;
+    VkBuffer edram_copy = VK_NULL_HANDLE;
+    VkDeviceMemory edram_memory = VK_NULL_HANDLE;
+    void* edram_mapping = nullptr;
+    if (dump_edram &&
+        (!ui::vulkan::util::CreateDedicatedAllocationBuffer(
+             vulkan_device, xenos::kEdramSizeBytes, VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+             ui::vulkan::util::MemoryPurpose::kReadback, edram_copy, edram_memory) ||
+         dfn.vkMapMemory(device, edram_memory, 0, VK_WHOLE_SIZE, 0, &edram_mapping) != VK_SUCCESS)) {
+      edram_mapping = nullptr;
+    }
+    if (ui::vulkan::util::CreateDedicatedAllocationBuffer(
+            vulkan_device, written_length, VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+            ui::vulkan::util::MemoryPurpose::kReadback, buffer, memory) &&
+        dfn.vkMapMemory(device, memory, 0, VK_WHOLE_SIZE, 0, &mapping) == VK_SUCCESS) {
+      shared_memory_->Use(VulkanSharedMemory::Usage::kRead);
+      SubmitBarriers(true);
+      VkBufferCopy region = {};
+      region.srcOffset = written_address;
+      region.size = written_length;
+      deferred_command_buffer_.CmdVkCopyBuffer(shared_memory_->buffer(), buffer, 1, &region);
+      PushBufferMemoryBarrier(buffer, 0, written_length, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                              VK_PIPELINE_STAGE_HOST_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+                              VK_ACCESS_HOST_READ_BIT);
+      if (edram_mapping) {
+        render_target_cache_->UseEdramBufferForTransferRead();
+        SubmitBarriers(true);
+        VkBufferCopy edram_region = {};
+        edram_region.size = xenos::kEdramSizeBytes;
+        deferred_command_buffer_.CmdVkCopyBuffer(render_target_cache_->edram_buffer(), edram_copy, 1,
+                                                 &edram_region);
+        PushBufferMemoryBarrier(edram_copy, 0, xenos::kEdramSizeBytes, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                                VK_PIPELINE_STAGE_HOST_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+                                VK_ACCESS_HOST_READ_BIT);
+      }
+      if (AwaitAllQueueOperationsCompletion()) {
+        VkMappedMemoryRange range = {};
+        range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+        range.memory = memory;
+        range.size = VK_WHOLE_SIZE;
+        dfn.vkInvalidateMappedMemoryRanges(device, 1, &range);
+        std::ofstream out(fmt::format("{}/res_{:04}.bin", g_report.folder, seq), std::ios::binary);
+        out.write(static_cast<const char*>(mapping), std::streamsize(written_length));
+        if (!out) {
+          REXGPU_ERROR("[frame report] cannot write {}/res_{:04}.bin", g_report.folder, seq);
+          line += " (write failed)";
+        }
+        if (edram_mapping) {
+          range.memory = edram_memory;
+          dfn.vkInvalidateMappedMemoryRanges(device, 1, &range);
+          std::ofstream edram(fmt::format("{}/edram_{:04}.bin", g_report.folder, seq), std::ios::binary);
+          edram.write(static_cast<const char*>(edram_mapping), std::streamsize(xenos::kEdramSizeBytes));
+          line += " edram dumped";
+        }
+      } else {
+        line += " (wait failed)";
+      }
+      dfn.vkUnmapMemory(device, memory);
+    } else {
+      line += " (no readback buffer)";
+    }
+    if (buffer != VK_NULL_HANDLE) dfn.vkDestroyBuffer(device, buffer, nullptr);
+    if (memory != VK_NULL_HANDLE) dfn.vkFreeMemory(device, memory, nullptr);
+    if (edram_mapping) dfn.vkUnmapMemory(device, edram_memory);
+    if (edram_copy != VK_NULL_HANDLE) dfn.vkDestroyBuffer(device, edram_copy, nullptr);
+    if (edram_memory != VK_NULL_HANDLE) dfn.vkFreeMemory(device, edram_memory, nullptr);
+  }
+  std::ofstream index(g_report.folder + "/index.txt", std::ios::app);
+  index << line << "\n";
+  if (g_report.sequence.is_open()) {
+    g_report.sequence << "resolve " << line << "\n";
+  }
+  if (!index) {
+    REXGPU_ERROR("[frame report] cannot write {}/index.txt", g_report.folder);
+  }
+}
