+  ++g_report.report_index;
+  // Absolute, beside the executable (/app0 on the PS5) unless set: the
+  // working directory is not reliably the app's folder.
+  std::string root = REXCVAR_GET(frame_report_path);
+  if (root.empty()) {
+    root = (rex::filesystem::GetExecutableFolder() / "logs" / "frame_reports").string();
+  }
+  g_report.folder = fmt::format("{}/{:03}", root, g_report.report_index);
+  std::error_code ec;
+  std::filesystem::create_directories(g_report.folder, ec);
+  if (ec) {
+    REXGPU_ERROR("[frame report] cannot create {}: {}", g_report.folder, ec.message());
+  }
+  g_report.frames_left = std::max(1, REXCVAR_GET(frame_report_frames));
+  g_report.frame = 0;
+  g_report.resolves = 0;
+  g_report.draws = 0;
+  g_report.sequence.close();
+  g_report.sequence.open(g_report.folder + "/draws.txt", std::ios::trunc);
+  REXGPU_INFO("[frame report] capturing {} frame(s) into {}", g_report.frames_left, g_report.folder);
+}
+
+// One draw of a frame report: its render target and every texture its shaders
+// fetch, so a pass that samples a resolved image can be matched to the resolve.
+void FrameReportDraw(const RegisterFile& regs, const VulkanShader* vertex_shader,
+                     const VulkanShader* pixel_shader) {
+  if (g_report.frames_left <= 0 || !g_report.sequence.is_open() || g_report.draws >= 6000) {
+    return;
+  }
+  const uint32_t n = g_report.draws++;
+  const auto surface = regs.Get<reg::RB_SURFACE_INFO>();
+  const auto color0 = regs.Get<reg::RB_COLOR_INFO>();
+  const auto depth = regs.Get<reg::RB_DEPTH_INFO>();
+  std::string line = fmt::format(
+      "draw {} frame {} vs {:016X} ps {:016X} rt pitch {} msaa {} color0 base {} format {} mask {:04X} "
+      "depth base {} format {} edram_mode {}",
+      n, g_report.frame, vertex_shader ? vertex_shader->ucode_data_hash() : 0,
+      pixel_shader ? pixel_shader->ucode_data_hash() : 0, uint32_t(surface.surface_pitch),
+      uint32_t(surface.msaa_samples), uint32_t(color0.color_base), uint32_t(color0.color_format),
+      regs.Get<reg::RB_COLOR_MASK>().value & 0xFFFF, uint32_t(depth.depth_base),
+      uint32_t(depth.depth_format), uint32_t(regs.Get<reg::RB_MODECONTROL>().edram_mode));
+  uint32_t seen = 0;
+  for (const VulkanShader* shader : {vertex_shader, pixel_shader}) {
+    if (!shader) continue;
+    for (const auto& binding : shader->GetTextureBindingsAfterTranslation()) {
+      const uint32_t fc = binding.fetch_constant;
+      if (seen & (1u << fc)) continue;
+      seen |= 1u << fc;
+      const auto fetch = regs.GetTextureFetch(fc);
+      uint32_t w = 0, h = 0;
+      switch (fetch.dimension) {
+        case xenos::DataDimension::k1D: w = fetch.size_1d.width + 1, h = 1; break;
+        case xenos::DataDimension::k3D: w = fetch.size_3d.width + 1, h = fetch.size_3d.height + 1; break;
+        default: w = fetch.size_2d.width + 1, h = fetch.size_2d.height + 1; break;
+      }
+      line += fmt::format(" | tex{} {:08X} fmt {} {}x{} dim {} endian {} tiled {} pitch {} exp {} "
+                          "signs {}{}{}{} swz {:03X} type {}",
+                          fc, uint32_t(fetch.base_address) << 12, uint32_t(fetch.format), w, h,
+                          uint32_t(fetch.dimension), uint32_t(fetch.endianness), uint32_t(fetch.tiled),
+                          uint32_t(fetch.pitch), int32_t(fetch.exp_adjust), uint32_t(fetch.sign_x),
+                          uint32_t(fetch.sign_y), uint32_t(fetch.sign_z), uint32_t(fetch.sign_w),
+                          uint32_t(fetch.swizzle), uint32_t(fetch.type));
+    }
+  }
+  g_report.sequence << line << "\n";
+}
